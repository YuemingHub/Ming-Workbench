{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaop.dev/schemas/capability-matrix.schema.json",
  "title": "AAOP Capability Matrix",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "required", "status"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["available", "partial", "missing", "blocked"]},
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "properties": {
                "type": {"type": "string"},
                "name": {"type": "string"},
                "scope": {"type": ["string", "null"]},
                "risk": {"enum": ["low", "medium", "high"]}
              },
              "additionalProperties": true
            }
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "gap_resolution": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "composition_edges": {
      "type": "array",
      "description": "Material provider/capability handoffs required to form the accepted end-to-end execution path. Omit trivial in-process edges.",
      "items": {
        "type": "object",
        "required": ["from", "to", "status", "transfer"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "status": {"enum": ["available", "partial", "missing", "blocked"]},
          "transfer": {"type": "string"},
          "identity_requirement": {"type": ["string", "null"]},
          "provenance_requirement": {"type": ["string", "null"]},
          "authorization_requirement": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "gap_resolution": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
