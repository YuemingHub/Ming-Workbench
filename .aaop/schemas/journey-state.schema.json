{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaop.dev/schemas/journey-state.schema.json",
  "title": "AAOP Journey Checkpoint State",
  "type": "object",
  "required": [
    "schema_version",
    "journey_id",
    "journey_version",
    "revision",
    "cycle",
    "goal",
    "status",
    "current_gate",
    "current_route",
    "target_verified",
    "target_evidence",
    "evidence",
    "blockers",
    "route_history",
    "release_history",
    "completed_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "journey_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "journey_version": {"type": "string"},
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic compare-and-swap token. Every successful checkpoint mutation increments it; callers must write against the revision they most recently read."
    },
    "cycle": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "blocked", "complete"]},
    "current_gate": {"type": "string", "minLength": 1},
    "current_route": {"type": ["string", "null"]},
    "current_outcome": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "target_verified": {"type": "boolean"},
    "target_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "route_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle", "from", "to", "reason", "at"],
        "properties": {
          "cycle": {"type": "integer", "minimum": 1},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "release_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle", "completed_at", "outcome", "target_evidence"],
        "properties": {
          "cycle": {"type": "integer", "minimum": 1},
          "completed_at": {"type": "string", "format": "date-time"},
          "outcome": {"type": ["string", "null"]},
          "target_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "completed_at": {"type": ["string", "null"]},
    "last_checkpoint_reason": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
